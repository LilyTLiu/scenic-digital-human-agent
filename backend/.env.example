DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=512
GUIDE_REPLY_MAX_CHARS=180
GUIDE_REPLY_BRIEF_CHARS=80

# ASR: faster-whisper model. Reliable local default: base.
# Higher accuracy but slower/heavier after pre-download: small, medium, or large-v3.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
ASR_BEAM_SIZE=5
ASR_BEST_OF=5
ASR_VAD_FILTER=1
ASR_HF_HUB_OFFLINE=0

TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_TIMEOUT=120

# 接 CosyVoice/MeloTTS/GPT-SoVITS 等本地开源 TTS 服务时使用：
# TTS_PROVIDER=local_http
# TTS_LOCAL_HTTP_URL=http://127.0.0.1:9880/tts
# TTS_LOCAL_FORMAT=wav
# TTS_LOCAL_SPEAKER=
