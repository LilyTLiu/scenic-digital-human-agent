# DeepSeek API 配置
# 在此填写你的 API Key，启动后端时自动加载，无需每次手动设置环境变量
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 模型选择 (可选，默认为 deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Whisper 模型 (可选: tiny, base, small, medium, large)
# WHISPER_MODEL=base

# TTS 默认声线 (可选)
# TTS_VOICE=zh-CN-XiaoxiaoNeural
