# ══════════════════════════════════════════════════════════════
# 灵山胜境数字人导游 — 生产环境配置
# 复制为 deploy/.env 并填入真实值
#   cp deploy/.env.example deploy/.env
# ══════════════════════════════════════════════════════════════

# ── DeepSeek API（必填）──
# 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── ASR 语音识别 ──
WHISPER_MODEL=base

# ── TTS 语音 ──
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ══════════════════════════════════════════════════════════════
# 下面变量是「前端」用的，写在 deploy/.env 里没意义！
# 前端变量必须写在 frontend/.env（Vite 构建时读取）。
# 部署脚本 deploy.sh 会自动把 .env.example 复制为 frontend/.env。
# ══════════════════════════════════════════════════════════════

# ── 魔珐星云数字人（可选，不填则只能用文字对话）──
# 在魔珐星云开放平台创建应用获取 App ID / App Secret
VITE_XMOV_APP_ID=
VITE_XMOV_APP_SECRET=

# 导游小云（可选）
VITE_XMOV_AVATAR_2_ID=
VITE_XMOV_AVATAR_2_SECRET=

# 导游小灵（可选）
VITE_XMOV_AVATAR_3_ID=
VITE_XMOV_AVATAR_3_SECRET=

VITE_XMOV_SDK_URL=https://media.xingyun3d.com/xingyun3d/general/litesdk/xmovAvatar@latest.js
VITE_XMOV_GATEWAY_SERVER=https://nebula-agent.xingyun3d.com/user/v1/ttsa/session

# ── 高德地图（可选，不填则游园地图显示静态提示）──
# 在高德开放平台申请 Web端 JS API Key
VITE_AMAP_KEY=
VITE_AMAP_SECRET=
