# 阶段 1：构建 React 应用
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .

# 魔珐星云数字人 & 高德地图（构建时注入，可选）
ARG VITE_XMOV_APP_ID
ARG VITE_XMOV_APP_SECRET
ARG VITE_XMOV_AVATAR_2_ID
ARG VITE_XMOV_AVATAR_2_SECRET
ARG VITE_XMOV_AVATAR_3_ID
ARG VITE_XMOV_AVATAR_3_SECRET
ARG VITE_XMOV_SDK_URL
ARG VITE_XMOV_GATEWAY_SERVER
ARG VITE_AMAP_KEY
ARG VITE_AMAP_SECRET

ENV VITE_XMOV_APP_ID=$VITE_XMOV_APP_ID
ENV VITE_XMOV_APP_SECRET=$VITE_XMOV_APP_SECRET
ENV VITE_XMOV_AVATAR_2_ID=$VITE_XMOV_AVATAR_2_ID
ENV VITE_XMOV_AVATAR_2_SECRET=$VITE_XMOV_AVATAR_2_SECRET
ENV VITE_XMOV_AVATAR_3_ID=$VITE_XMOV_AVATAR_3_ID
ENV VITE_XMOV_AVATAR_3_SECRET=$VITE_XMOV_AVATAR_3_SECRET
ENV VITE_XMOV_SDK_URL=$VITE_XMOV_SDK_URL
ENV VITE_XMOV_GATEWAY_SERVER=$VITE_XMOV_GATEWAY_SERVER
ENV VITE_AMAP_KEY=$VITE_AMAP_KEY
ENV VITE_AMAP_SECRET=$VITE_AMAP_SECRET

RUN npm run build

# 阶段 2：nginx 提供静态文件 + API 反向代理
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
